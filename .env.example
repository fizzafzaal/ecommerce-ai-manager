# Database (SQLite file, no server needed)
DATABASE_URL=sqlite:///./ecommerce.db

# Ollama / LLM
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=phi
MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=45

# Set to false for "safe mode": no language model is loaded (much less
# RAM). Refunds, product search, and FAQs still work fully; only the
# friendly wording of replies is simpler. Default true.
USE_LLM=true

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Groq cloud LLM (optional -- powers the "smart" agentic assistant).
# Get a free key at https://console.groq.com and paste it below. If left
# blank, the assistant falls back to the local phi model automatically.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# App
ENVIRONMENT=development
